# Connected local backend configuration. Gemini is primary; Groq is used if Gemini fails.
AI_STUDY_ENVIRONMENT=development
AI_STUDY_AUTH_MODE=auto
AI_STUDY_DATA_BACKEND=firestore
AI_STUDY_GEMINI_API_KEY=your_google_ai_studio_api_key
AI_STUDY_GEMINI_MODEL=gemini-3.5-flash-lite
AI_STUDY_GEMINI_FALLBACK_MODELS=["gemini-3.6-flash", "gemini-3.8-flash"]
AI_STUDY_GEMINI_TIMEOUT_SECONDS=25
AI_STUDY_GROQ_API_KEY=your_groq_api_key
AI_STUDY_GROQ_MODEL=openai/gpt-oss-20b
AI_STUDY_GROQ_TIMEOUT_SECONDS=15
AI_STUDY_FIREBASE_PROJECT_ID=ai-study-assistant-26
AI_STUDY_FIREBASE_STORAGE_BUCKET=ai-study-assistant-26.firebasestorage.app
AI_STUDY_FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
AI_STUDY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
